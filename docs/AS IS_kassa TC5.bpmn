<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_06xtes1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.10.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0"><bpmn:collaboration id="Collaboration_0xf2kjg"><bpmn:participant id="Participant_0nsqisl" name="Работа с кассами и КСО" processRef="Process_1pnr8zd" /><bpmn:participant id="Participant_1gfvwfu" name="Административные операции на кассе" processRef="Process_1noq09f" /><bpmn:participant id="Participant_0lbcryc" name="GK POS" /><bpmn:participant id="Participant_0dbt7rz" name="Контрольный пересчёт кассира" processRef="Process_0ppfoim" /><bpmn:participant id="Participant_1tlal1s" name="Промежуточная инкассация" processRef="Process_1ep20sg" /><bpmn:participant id="Participant_1p8bxmv" name="Возврат товара от покупателя" processRef="Process_0p9by5a" /><bpmn:participant id="Participant_0cbdjxk" name="ТСД" /><bpmn:participant id="Participant_1ruiio9" name="Продажа товара на кассе" processRef="Process_0kodtiu" /><bpmn:messageFlow id="Flow_11xun1f" sourceRef="Activity_0k3jpfz" targetRef="Participant_0lbcryc" /><bpmn:messageFlow id="Flow_09ta32n" sourceRef="Activity_0lmv2fe" targetRef="Participant_1gfvwfu" /><bpmn:messageFlow id="Flow_0ebsf7p" sourceRef="Activity_0cja4ij" targetRef="Participant_0dbt7rz" /><bpmn:messageFlow id="Flow_1exvzqb" sourceRef="Activity_0i82ydz" targetRef="Participant_1p8bxmv" /><bpmn:messageFlow id="Flow_1drqamw" sourceRef="Activity_1rddnf9" targetRef="Participant_1tlal1s" /><bpmn:messageFlow id="Flow_1x0t82t" sourceRef="Activity_0ylp3lf" targetRef="Participant_0cbdjxk" /><bpmn:messageFlow id="Flow_1xnu9sv" sourceRef="Activity_00mpaa8" targetRef="Participant_1ruiio9" /><bpmn:messageFlow id="Flow_1fskff1" sourceRef="Activity_00zddjs" targetRef="Participant_0lbcryc" /><bpmn:messageFlow id="Flow_0yuoaw4" sourceRef="Activity_05odtxl" targetRef="Participant_0lbcryc" /><bpmn:textAnnotation id="TextAnnotation_0wg8ikr"><bpmn:text>Изменение кол-ва в чеке, сторно, аннуляция, продажа по цене с ценника</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_12t7zli" sourceRef="Activity_0lmv2fe" targetRef="TextAnnotation_0wg8ikr" /><bpmn:textAnnotation id="TextAnnotation_18kqari"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0zeuoc0" sourceRef="Activity_0z7fkla" targetRef="TextAnnotation_18kqari" /><bpmn:textAnnotation id="TextAnnotation_1432x4r"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_032sy6u" sourceRef="Activity_1dg881r" targetRef="TextAnnotation_1432x4r" /><bpmn:textAnnotation id="TextAnnotation_1t1zk6q"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0s0a1zb" sourceRef="Activity_0em82ae" targetRef="TextAnnotation_1t1zk6q" /><bpmn:textAnnotation id="TextAnnotation_0gf9igf"><bpmn:text>выдача прав разблокируется, когда допустимое значение по параметру вернется в норматив</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_18k1346" sourceRef="Activity_0em82ae" targetRef="TextAnnotation_0gf9igf" /><bpmn:textAnnotation id="TextAnnotation_187w8nz"><bpmn:text>Допустимые значения метрик на каждую операцию:
• КЧ со сторно (ср/д) – 3% от общего количества чеков;
• КЧ аннуляций (ср/д) – 1% от общего количеств чеков;
• КЧ с ПЦЦ (ср/д) – 0,5% от общего количества чеков;
• ЧК возвратов (ср/д) – 0,5% от общего количества чеков.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1vv2445" sourceRef="Activity_0z7fkla" targetRef="TextAnnotation_187w8nz" /><bpmn:textAnnotation id="TextAnnotation_0dq9v1g"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_084tmqx" sourceRef="Activity_0k3jpfz" targetRef="TextAnnotation_0dq9v1g" /><bpmn:textAnnotation id="TextAnnotation_00nlrpq"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0qsbbpt" sourceRef="Activity_0ssv6qv" targetRef="TextAnnotation_00nlrpq" /><bpmn:textAnnotation id="TextAnnotation_0o0ddtr"><bpmn:text>Функции администратора на кассе (аннуляция чека, сторнирование, возврат товара, продажа по цене ценника и т.д.) можно осуществить с использованием штрих-кода (далее ШК) администратора. ШК администратора- индивидуален для каждого сотрудника администрации магазина и распечатывается из программы GK.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1fyzb80" sourceRef="Activity_0ssv6qv" targetRef="TextAnnotation_0o0ddtr" /><bpmn:textAnnotation id="TextAnnotation_0rzmyjc"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0z9cbgt" sourceRef="Activity_1fdltz5" targetRef="TextAnnotation_0rzmyjc" /><bpmn:textAnnotation id="TextAnnotation_18m1f62"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_13kv46k" sourceRef="Activity_1fa3bxi" targetRef="TextAnnotation_18m1f62" /><bpmn:textAnnotation id="TextAnnotation_06vfren"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_08ezh8c" sourceRef="Activity_1dqq0cb" targetRef="TextAnnotation_06vfren" /><bpmn:textAnnotation id="TextAnnotation_0yc1fk4"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_187mg7u" sourceRef="Activity_1d3a0u6" targetRef="TextAnnotation_0yc1fk4" /><bpmn:textAnnotation id="TextAnnotation_17o3g39"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ea1khb" sourceRef="Activity_1l7rput" targetRef="TextAnnotation_17o3g39" /><bpmn:textAnnotation id="TextAnnotation_063xctr"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_05fykmc" sourceRef="Activity_0fn0j52" targetRef="TextAnnotation_063xctr" /><bpmn:textAnnotation id="TextAnnotation_1dfn95c"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0rfq442" sourceRef="Activity_0mt3y7x" targetRef="TextAnnotation_1dfn95c" /><bpmn:textAnnotation id="TextAnnotation_1dazqrm"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1hl5082" sourceRef="Activity_1z06kld" targetRef="TextAnnotation_1dazqrm" /><bpmn:textAnnotation id="TextAnnotation_0yw3dyn"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0g7odmx" sourceRef="Activity_0thhtpj" targetRef="TextAnnotation_0yw3dyn" /><bpmn:textAnnotation id="TextAnnotation_0yc06o5"><bpmn:text>«Основные данные» –&gt; «Магазин» -&gt;
«Управление доступом кассира»</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_03kpu8k" sourceRef="Activity_047uikd" targetRef="TextAnnotation_0yc06o5" /><bpmn:textAnnotation id="TextAnnotation_0syemho"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1egzwcc" sourceRef="Activity_047uikd" targetRef="TextAnnotation_0syemho" /><bpmn:textAnnotation id="TextAnnotation_1n5l7tn"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0z0ajf5" sourceRef="Activity_1tmpisn" targetRef="TextAnnotation_1n5l7tn" /><bpmn:textAnnotation id="TextAnnotation_1yft9p6"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0swrexb" sourceRef="Activity_095zuvr" targetRef="TextAnnotation_1yft9p6" /><bpmn:textAnnotation id="TextAnnotation_16u9mit"><bpmn:text>По истечении 60 дней с момента трудоустройства в Менеджере заданий сформируется
уведомление об открытии доступа к функционалу выдачи прав кассиру</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1qb1kto" sourceRef="Activity_095zuvr" targetRef="TextAnnotation_16u9mit" /><bpmn:textAnnotation id="TextAnnotation_177bxsj"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_064m9qk" sourceRef="Activity_0idg7br" targetRef="TextAnnotation_177bxsj" /><bpmn:textAnnotation id="TextAnnotation_02kt3ye"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1lgxgbp" sourceRef="Activity_1xoerl0" targetRef="TextAnnotation_02kt3ye" /><bpmn:textAnnotation id="TextAnnotation_15sblp6"><bpmn:text>ДМне сможет присвоить дополнительный доступ кассиру, если:
1. Кассир отработал в магазине менее 90 дней;
2. Кассир не привлекался к работе на кассе за последние 90 дней;
3. Кассир имеет превышение по допустимому значению по операциям сторно, аннуляция чека, продажа по цене с ценника и возврат.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_09inobp" sourceRef="Activity_1xoerl0" targetRef="TextAnnotation_15sblp6" /><bpmn:textAnnotation id="TextAnnotation_0sf4dso"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0ot5n4d" sourceRef="Activity_0y5v86z" targetRef="TextAnnotation_0sf4dso" /><bpmn:textAnnotation id="TextAnnotation_0ulcu8x"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1sz4110" sourceRef="Activity_05odtxl" targetRef="TextAnnotation_0ulcu8x" /><bpmn:textAnnotation id="TextAnnotation_1b2bz55"><bpmn:text>Допустимые значения на каждую операцию:
• КЧ со сторно (ср/д) – 3% от общего количества чеков;
• КЧ аннуляций (ср/д) – 1% от общего количеств чеков;
• КЧ с ПЦЦ (ср/д) – 0,5% от общего количества чеков;
• ЧК возвратов (ср/д) – 0,5% от общего количества чеков.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1wfpott" sourceRef="Activity_1c7opeb" targetRef="TextAnnotation_1b2bz55" /><bpmn:textAnnotation id="TextAnnotation_1w9sokt"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0k0ehns" sourceRef="Activity_00zddjs" targetRef="TextAnnotation_1w9sokt" /><bpmn:textAnnotation id="TextAnnotation_0flc756"><bpmn:text>выдача прав разблокируется, когда допустимое значение по параметру вернется в норматив</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0gt79s7" sourceRef="Activity_00zddjs" targetRef="TextAnnotation_0flc756" /><bpmn:textAnnotation id="TextAnnotation_0qzft1v"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1kkapt2" sourceRef="Activity_1c7opeb" targetRef="TextAnnotation_0qzft1v" /><bpmn:textAnnotation id="TextAnnotation_0qe358a"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0d1n25q" sourceRef="Activity_0wrye71" targetRef="TextAnnotation_0qe358a" /><bpmn:textAnnotation id="TextAnnotation_0ycum4q"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0e381gl" sourceRef="Activity_0hdjzqo" targetRef="TextAnnotation_0ycum4q" /><bpmn:textAnnotation id="TextAnnotation_02rv198"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_04srna7" sourceRef="TextAnnotation_02rv198" targetRef="Activity_06fnr86" /><bpmn:textAnnotation id="TextAnnotation_0su7y8i"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0grioil" sourceRef="Activity_1u9qi4x" targetRef="TextAnnotation_0su7y8i" /><bpmn:textAnnotation id="TextAnnotation_0lokeqm"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_057hu0d" sourceRef="Activity_0ylp3lf" targetRef="TextAnnotation_0lokeqm" /><bpmn:textAnnotation id="TextAnnotation_1nnoj1f"><bpmn:text>по этому действию данные уходят на ТСД</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_01i6439" sourceRef="Activity_0ylp3lf" targetRef="TextAnnotation_1nnoj1f" /><bpmn:textAnnotation id="TextAnnotation_0m4rq51"><bpmn:text>Периодичность контрольных пересчетов:
-Внезапные (для кассиров) – проводятся не менее 2 раз в смену на различных кассах.
-При закрытии смены, после расчета касс.
-При передаче денежного ящика от кассира другому кассиру в течение рабочего дня (через расчёт кассы).
-При неполадках на кассе - проводит АДМ / ЗДМ / ДМ / ДМП / ДГМП.
-При конфликте с покупателем о неверно выданной сдаче
Также инициаторами проведения контрольного пересчёта могут быть сотрудники безопасности и ДК, при наличии подозрений на нарушения кассовой дисциплины и при проведении контрольных мероприятий</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_00ryt5q"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0otyi90" sourceRef="Activity_13kd56j" targetRef="TextAnnotation_00ryt5q" /><bpmn:textAnnotation id="TextAnnotation_04mk432"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0pu55a6" sourceRef="Activity_0esh9sa" targetRef="TextAnnotation_04mk432" /><bpmn:textAnnotation id="TextAnnotation_0yk3zar"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1uq4beo" sourceRef="Activity_1qxhtmd" targetRef="TextAnnotation_0yk3zar" /><bpmn:textAnnotation id="TextAnnotation_066p1hu"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0j8pj7b" sourceRef="Activity_1b1ygdp" targetRef="TextAnnotation_066p1hu" /><bpmn:textAnnotation id="TextAnnotation_0tp29pw"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0yqo4mj" sourceRef="Activity_0u8k8p2" targetRef="TextAnnotation_0tp29pw" /><bpmn:textAnnotation id="TextAnnotation_0s7pfxq"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1dndgzl" sourceRef="Activity_0mnq34e" targetRef="TextAnnotation_0s7pfxq" /><bpmn:textAnnotation id="TextAnnotation_116rjor"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0elfp6s" sourceRef="Activity_0dxdnyb" targetRef="TextAnnotation_116rjor" /><bpmn:textAnnotation id="TextAnnotation_0mem063"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_05akq1c" sourceRef="Activity_000uwiv" targetRef="TextAnnotation_0mem063" /><bpmn:textAnnotation id="TextAnnotation_138gd7k"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0kvxp9z" sourceRef="Activity_0o4thtk" targetRef="TextAnnotation_138gd7k" /><bpmn:textAnnotation id="TextAnnotation_00dkfgz"><bpmn:text>В случае расхождений перед тем, как нажать кнопку
«Сохранить» необходимо проверить количество купюр
построчно и сумму монет. При необходимости внести
корректировки. Если ошибок нет, то необходимо подтвердить
сохранение пересчета с расхождением.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_03ntwov" sourceRef="Activity_1l1ndgc" targetRef="TextAnnotation_00dkfgz" /><bpmn:textAnnotation id="TextAnnotation_195y8ds"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_15m9fpv" sourceRef="Activity_00u37gq" targetRef="TextAnnotation_195y8ds" /><bpmn:textAnnotation id="TextAnnotation_1axd0f3"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0u0f21j" sourceRef="Activity_1l1ndgc" targetRef="TextAnnotation_1axd0f3" /><bpmn:textAnnotation id="TextAnnotation_01yenwa"><bpmn:text>ТСД WinCE, MGK, Аура</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1uq7lxv" sourceRef="Activity_135y104" targetRef="TextAnnotation_01yenwa" /><bpmn:textAnnotation id="TextAnnotation_0x2t2rl"><bpmn:text>GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_05ajdq9" sourceRef="Activity_0hf73uj" targetRef="TextAnnotation_0x2t2rl" /><bpmn:textAnnotation id="TextAnnotation_1cestaq"><bpmn:text>Кассиру необходимо внести недостающую сумму в кассу, согласно подписанному договору об индивидуальной и материальной ответственности в соответствии с которым работник принимает на себя полную материальную ответственность за недостачу вверенного ему имущества, а также за ущерб иным лицам</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0qarima" sourceRef="Activity_0tpgzmb" targetRef="TextAnnotation_1cestaq" /><bpmn:textAnnotation id="TextAnnotation_13vrnjl"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0neh0n1" sourceRef="Activity_1faf7b7" targetRef="TextAnnotation_13vrnjl" /><bpmn:textAnnotation id="TextAnnotation_15f55zq"><bpmn:text>GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1qlzya3" sourceRef="Activity_020qi0v" targetRef="TextAnnotation_15f55zq" /><bpmn:textAnnotation id="TextAnnotation_1crckl2"><bpmn:text>Кассир возвращает денежный ящик на кассу, устанавливает его и продолжает обслуживать покупателей</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1vjzprv" sourceRef="TextAnnotation_1crckl2" targetRef="Event_1ajcosi" /><bpmn:textAnnotation id="TextAnnotation_1at69s6"><bpmn:text>При превышении лимита денежных средств в денежном ящике, на кассе появится уведомление о необходимости проведения промежуточной инкассации.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_1pk95qw"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1aktkut" sourceRef="Activity_1laiklt" targetRef="TextAnnotation_1pk95qw" /><bpmn:textAnnotation id="TextAnnotation_067oq0p"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0tn7p2m" sourceRef="Activity_0pju9pn" targetRef="TextAnnotation_067oq0p" /><bpmn:textAnnotation id="TextAnnotation_1kcke0v"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1wfmrgj" sourceRef="Activity_1nf4sl2" targetRef="TextAnnotation_1kcke0v" /><bpmn:textAnnotation id="TextAnnotation_0ot0o7q"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0vhe6et" sourceRef="Activity_1ex1ule" targetRef="TextAnnotation_0ot0o7q" /><bpmn:textAnnotation id="TextAnnotation_0xxrjbr"><bpmn:text>Запрещается:
Проведение промежуточных инкассаций без Администратора, а также без участия Кассира, за исключением форс-мажора;
Совмещать инкассации двух и более касс одновременно;
Перемещать денежный ящик с денежными средствами в ГК без крышки.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_0zi3ws1"><bpmn:text>при отсутствии суммы выручки на кассе возврат сделать нельзя</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0mk1j5w" sourceRef="Activity_12oq2vz" targetRef="TextAnnotation_0zi3ws1" /><bpmn:textAnnotation id="TextAnnotation_1dqa14d"><bpmn:text>цену можно выбрать из списка или ввести руками</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ybibx5" sourceRef="Activity_0ggom7i" targetRef="TextAnnotation_1dqa14d" /><bpmn:textAnnotation id="TextAnnotation_0bvv35g"><bpmn:text>при возврате без чека возврат всегда выполняется наличными, при возврате по чеку возврат тем способом, как была оплата</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1iuju7x" sourceRef="Activity_1coft9f" targetRef="TextAnnotation_0bvv35g" /><bpmn:textAnnotation id="TextAnnotation_0ed51t0"><bpmn:text>При обмене товар должен быть одного PLU. Товар с маркировкой (DM и акцизной маркой) не подлежит обмену, необходимо оформить возврат на кассе и продажу нового.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_171e0ej" sourceRef="Activity_0ecqy23" targetRef="TextAnnotation_0ed51t0" /><bpmn:textAnnotation id="TextAnnotation_02pp7x7"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1v2if3i" sourceRef="Activity_1ca3pes" targetRef="TextAnnotation_02pp7x7" /><bpmn:textAnnotation id="TextAnnotation_1yq0426"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0ggnl73" sourceRef="Activity_0jyl4f0" targetRef="TextAnnotation_1yq0426" /><bpmn:textAnnotation id="TextAnnotation_0sxvfn4"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0e8qzpa" sourceRef="Activity_1q2txku" targetRef="TextAnnotation_0sxvfn4" /><bpmn:textAnnotation id="TextAnnotation_1b00mfa"><bpmn:text>Для поиска чека вручную можно внести дату, номер чека, номер кассы</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1tjyy3w" sourceRef="Activity_1q2txku" targetRef="TextAnnotation_1b00mfa" /><bpmn:textAnnotation id="TextAnnotation_0kqn9f7"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0qkwkld" sourceRef="Activity_11ngbnf" targetRef="TextAnnotation_0kqn9f7" /><bpmn:textAnnotation id="TextAnnotation_1qa8zdv"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_07p2rhj" sourceRef="Activity_1t6b7mv" targetRef="TextAnnotation_1qa8zdv" /><bpmn:textAnnotation id="TextAnnotation_1rothvj"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0udmzi2" sourceRef="Activity_0f0935z" targetRef="TextAnnotation_1rothvj" /><bpmn:textAnnotation id="TextAnnotation_0xuyohx"><bpmn:text>BO GK</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_19khqo1" sourceRef="Activity_1uorodg" targetRef="TextAnnotation_0xuyohx" /><bpmn:textAnnotation id="TextAnnotation_11gu628"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0eism9a" sourceRef="Activity_12oq2vz" targetRef="TextAnnotation_11gu628" /><bpmn:textAnnotation id="TextAnnotation_1djzllx"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_10h8a4v" sourceRef="Activity_0vwxlx8" targetRef="TextAnnotation_1djzllx" /><bpmn:textAnnotation id="TextAnnotation_0pznhhb"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0iq9ief" sourceRef="Activity_10u39ia" targetRef="TextAnnotation_0pznhhb" /><bpmn:textAnnotation id="TextAnnotation_11qosdt"><bpmn:text>В возврате денежных средств за товар следует ОТКАЗАТЬ в случаях:
-Если не удалось установить факт продажи товара в магазине;
-Если возвращаемый товар НЕ может быть предъявлен гостем.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1yofo23" sourceRef="Activity_1gf0cfx" targetRef="TextAnnotation_11qosdt" /><bpmn:textAnnotation id="TextAnnotation_1p1nhw2"><bpmn:text>в TO BE на этом шаге можно сканировать карту лояльности для поиска чека или искать чек путём сканирования DataMatrix</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_1fe0tl3"><bpmn:text>Уточнить дату и время покупки;
Уточнить, какой товар был куплен помимо возвращаемого;
Проверить факт продажи (в программе GK, по видеонаблюдению и т.п.)</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_09xecxn" sourceRef="Activity_1vzuio2" targetRef="TextAnnotation_1fe0tl3" /><bpmn:textAnnotation id="TextAnnotation_0y77sgy"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1j4ga3k" sourceRef="Activity_10na3fy" targetRef="TextAnnotation_0y77sgy" /><bpmn:textAnnotation id="TextAnnotation_1ncmtev"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_13hle1b" sourceRef="Activity_1tsg5f9" targetRef="TextAnnotation_1ncmtev" /><bpmn:textAnnotation id="TextAnnotation_1otqme0"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1tr29w5" sourceRef="Activity_0w37l4z" targetRef="TextAnnotation_1otqme0" /><bpmn:textAnnotation id="TextAnnotation_1ch59c8"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0wmeywa" sourceRef="Activity_1im9gs2" targetRef="TextAnnotation_1ch59c8" /><bpmn:textAnnotation id="TextAnnotation_1jfzsk2"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0wrh4ba" sourceRef="Activity_1celj06" targetRef="TextAnnotation_1jfzsk2" /><bpmn:textAnnotation id="TextAnnotation_11r8x7r"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1l919zt" sourceRef="Activity_1r4yv5y" targetRef="TextAnnotation_11r8x7r" /><bpmn:textAnnotation id="TextAnnotation_0kh8j5t"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1bsa9n3" sourceRef="Activity_0kmr9ep" targetRef="TextAnnotation_0kh8j5t" /><bpmn:textAnnotation id="TextAnnotation_1lpiss0"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1674oyo" sourceRef="Activity_0uivsfm" targetRef="TextAnnotation_1lpiss0" /><bpmn:textAnnotation id="TextAnnotation_12n9bly"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0oy7lq8" sourceRef="Activity_0ggom7i" targetRef="TextAnnotation_12n9bly" /><bpmn:textAnnotation id="TextAnnotation_0f3acgf"><bpmn:text>Если покупатель с его слов приобретал товар сегодня - возврат оформить по текущей цене;
Если покупатель купил товар ранее - уточнить дату, оформить возврат товара по цене на дату покупки. Цену товара в прошлом периоде можно посмотреть в GK в меню ОСТАТКИ =&gt; История движения товара =&gt; Графа «Цена на кассе».</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0aclkss" sourceRef="Activity_0ggom7i" targetRef="TextAnnotation_0f3acgf" /><bpmn:textAnnotation id="TextAnnotation_1vf3mqo"><bpmn:text>система при возврате товара без чека даёт текущую цену, диапазон цен можно менять как вверх, так и вниз</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0398ox8" sourceRef="Activity_0kmr9ep" targetRef="TextAnnotation_1vf3mqo" /><bpmn:textAnnotation id="TextAnnotation_04linxj"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0otcc3k" sourceRef="Activity_0ldc997" targetRef="TextAnnotation_04linxj" /><bpmn:textAnnotation id="TextAnnotation_0wfw99q"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ol8q3h" sourceRef="Activity_1roaz2w" targetRef="TextAnnotation_0wfw99q" /><bpmn:textAnnotation id="TextAnnotation_0tko95s"><bpmn:text>возврат без чека только наличными
если возврат по чеку и безнал - то покупатель прикладывает карту к пин-паду</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_1qj03we"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0o8yaut" sourceRef="Activity_1gjit50" targetRef="TextAnnotation_1qj03we" /><bpmn:textAnnotation id="TextAnnotation_0kjmug6"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0rhsfml" sourceRef="Activity_0udxptr" targetRef="TextAnnotation_0kjmug6" /><bpmn:textAnnotation id="TextAnnotation_1am1dle"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1x3vot4" sourceRef="Activity_1n90x3k" targetRef="TextAnnotation_1am1dle" /><bpmn:textAnnotation id="TextAnnotation_01vlk2l"><bpmn:text>при возврате по чеку мы знаем КИЗ и кассир вручную его выбирает на кассе, если возврат без чека система для маркировки запрашивает сканирование DM</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_17xz7d5" sourceRef="Activity_1n90x3k" targetRef="TextAnnotation_01vlk2l" /><bpmn:textAnnotation id="TextAnnotation_0if4ll3"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_14pmj23" sourceRef="Activity_1qw39xz" targetRef="TextAnnotation_0if4ll3" /><bpmn:textAnnotation id="TextAnnotation_02o0img"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_159ofrq" sourceRef="Activity_0f3yd4s" targetRef="TextAnnotation_02o0img" /><bpmn:textAnnotation id="TextAnnotation_1atejbl"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ugxj1o" sourceRef="Activity_0kl38pr" targetRef="TextAnnotation_1atejbl" /><bpmn:textAnnotation id="TextAnnotation_0vau9xq"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0ljkgkl" sourceRef="Activity_140xrcr" targetRef="TextAnnotation_0vau9xq" /><bpmn:textAnnotation id="TextAnnotation_1i3v52m"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0x2qo16" sourceRef="Activity_01mac4g" targetRef="TextAnnotation_1i3v52m" /><bpmn:textAnnotation id="TextAnnotation_0ixngoe"><bpmn:text>GK POS</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ct17ga" sourceRef="Activity_0oqbhbl" targetRef="TextAnnotation_0ixngoe" /><bpmn:textAnnotation id="TextAnnotation_19ccfi5"><bpmn:text>MAX</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_186ggd3" sourceRef="Activity_0k0ib20" targetRef="TextAnnotation_19ccfi5" /><bpmn:textAnnotation id="TextAnnotation_07l6jwb"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0x3egp1" sourceRef="Activity_1n1fiaq" targetRef="TextAnnotation_07l6jwb" /><bpmn:textAnnotation id="TextAnnotation_1e5r620"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1iihd1p" sourceRef="Activity_1sftgow" targetRef="TextAnnotation_1e5r620" /><bpmn:textAnnotation id="TextAnnotation_0oi9c7z"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1sbh3ap" sourceRef="Activity_1bw1hgi" targetRef="TextAnnotation_0oi9c7z" /><bpmn:textAnnotation id="TextAnnotation_07hjm7n"><bpmn:text>В момент, когда сканируется товар, Кассир просит у покупателя карту лояльности и сканирует между товарами ШК пластиковой карты лояльности или ШК карты лояльности с экрана мобильного телефона. Также карта лояльности может быть отсканирована после добавления в чек последнего товара.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1m5wddk" sourceRef="Activity_1sftgow" targetRef="TextAnnotation_07hjm7n" /><bpmn:textAnnotation id="TextAnnotation_1r7yh4p"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1b054co" sourceRef="Activity_1dw4il5" targetRef="TextAnnotation_1r7yh4p" /><bpmn:textAnnotation id="TextAnnotation_03al0bf"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_12i4f63" sourceRef="Activity_1fa47r5" targetRef="TextAnnotation_03al0bf" /><bpmn:textAnnotation id="TextAnnotation_04dct85"><bpmn:text>на кассе реализована сложная логика проверки возможности добавления товара в чек, например:
1. проверка валидности КИЗа или DataMatrix
2. проверка истекающего СГ для товара с маркировкой
3. проверка заблокированного к продаже товара
4. проверка окна времени продажи товара</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_18yl0ck" sourceRef="Activity_1fa47r5" targetRef="TextAnnotation_04dct85" /><bpmn:textAnnotation id="TextAnnotation_0dj3975"><bpmn:text>если кассир не подтверждает в диалоговом окне возраст покупателя, такой товар система не добавит в чек</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ba721v" sourceRef="Activity_1bw1hgi" targetRef="TextAnnotation_0dj3975" /><bpmn:textAnnotation id="TextAnnotation_1b0fh31"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1ncuxmf" sourceRef="Activity_0femq7p" targetRef="TextAnnotation_1b0fh31" /><bpmn:textAnnotation id="TextAnnotation_1asx8hr"><bpmn:text>При нажатии на кнопку «оплата», на кассе параллельно запускается 2 типа оплаты: оплата через банковский терминал и оплата наличными:
-если оплата принимается наличными - Кассир вводит сумму
-если оплата принимается по карте - покупатель прикладывает карту к терминалу
-если оплата принимается через СБП - Кассир нажимает кнопку СБП.
Когда включился терминал - покупатель самостоятельно выбирает на терминале оплату улыбкой, мульти QR, вжух.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1vtgpdp" sourceRef="Activity_10vtjoc" targetRef="TextAnnotation_1asx8hr" /><bpmn:textAnnotation id="TextAnnotation_19ko2si"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1j1cmi0" sourceRef="Activity_0feijzu" targetRef="TextAnnotation_19ko2si" /><bpmn:textAnnotation id="TextAnnotation_1766t58"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1i1s3z6" sourceRef="Activity_1x48uft" targetRef="TextAnnotation_1766t58" /><bpmn:textAnnotation id="TextAnnotation_0z7eilt"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0p51rad" sourceRef="Activity_10vtjoc" targetRef="TextAnnotation_0z7eilt" /><bpmn:textAnnotation id="TextAnnotation_01o0un5"><bpmn:text>на этом этапе выполняется расчёт стоимости к оплате с учётом всех всех скидок и механик по чеку</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0cff69l" sourceRef="Activity_0y4act9" targetRef="TextAnnotation_01o0un5" /><bpmn:textAnnotation id="TextAnnotation_0harfg5"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0wgkxwo" sourceRef="Activity_0y4act9" targetRef="TextAnnotation_0harfg5" /><bpmn:textAnnotation id="TextAnnotation_1my9kzn"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_00n6n5w" sourceRef="Activity_1i3fibv" targetRef="TextAnnotation_1my9kzn" /><bpmn:textAnnotation id="TextAnnotation_0u87kle"><bpmn:text>Кнопка «Скидки» нажимается в том случае, если к чеку необходимо применить следующие скидки:
• Списание баллов карты лояльности
• Скидка по VIP карте
• Скидка по купону
• Региональная социальная карта
• Соц. сертификат (это способ оплаты)
• Подарочный сертификат (это способ оплаты)
Сочетание разных типов скидок в чеке регулируется системой согласно матрице возможных пересечений.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_18avwbb" sourceRef="Activity_0feijzu" targetRef="TextAnnotation_0u87kle" /><bpmn:textAnnotation id="TextAnnotation_0hrr4n1"><bpmn:text>скидка пенсионера выделена в отдельную кнопку, при этом скидка пенсионера сработает только если в чек добавлена карта лояльности</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_1ii6xef"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1gpjc3f" sourceRef="Activity_1itqxum" targetRef="TextAnnotation_1ii6xef" /><bpmn:textAnnotation id="TextAnnotation_02aty0q"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0cwae4o" sourceRef="Activity_1ro491u" targetRef="TextAnnotation_02aty0q" /><bpmn:textAnnotation id="TextAnnotation_1bwnxrf"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0408155" sourceRef="Activity_0oltorr" targetRef="TextAnnotation_1bwnxrf" /><bpmn:textAnnotation id="TextAnnotation_0jj01sl"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0okr3t8" sourceRef="Activity_1q4hj1p" targetRef="TextAnnotation_0jj01sl" /><bpmn:textAnnotation id="TextAnnotation_0yy8efz"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_0z4g1sl" sourceRef="Activity_05ocena" targetRef="TextAnnotation_0yy8efz" /><bpmn:textAnnotation id="TextAnnotation_09drq6u"><bpmn:text>состав чека не меняется, PLU подарка в чек не добавляется</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1xlihoa" sourceRef="Activity_1itqxum" targetRef="TextAnnotation_09drq6u" /><bpmn:textAnnotation id="TextAnnotation_1tqthlg"><bpmn:text>при переходе к оплате если выполнены условия для выдачи подарка, то выдается окно с вопросом, если кассир нажимает "да" - то PLU подарка добавляется в чек и автоматом касса открывает состав чека - чтобы двинуться к оплате нужно нажать "ОПЛАТА", если кассир нажимает "нет", PLU подарка в чек не добавляется</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_08qthdy" sourceRef="Activity_1i3fibv" targetRef="TextAnnotation_1tqthlg" /><bpmn:textAnnotation id="TextAnnotation_1gcvb89"><bpmn:text>UDMF</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1w5a5a4" sourceRef="Activity_1qvss86" targetRef="TextAnnotation_1gcvb89" /></bpmn:collaboration><bpmn:process id="Process_1pnr8zd" isExecutable="true"><bpmn:exclusiveGateway id="Gateway_07q0zba" name="необходимо выполнить обратную операцию?"><bpmn:incoming>Flow_01rm3n2</bpmn:incoming><bpmn:outgoing>Flow_0urz1lp</bpmn:outgoing><bpmn:outgoing>Flow_1oxxo1q</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_0g8gu74"><bpmn:incoming>Flow_1oxxo1q</bpmn:incoming><bpmn:incoming>Flow_07eqlbg</bpmn:incoming><bpmn:outgoing>Flow_1cyb3yx</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:startEvent id="Event_1kce1np" name="Необходимо запустить работу на кассах и КСО"><bpmn:outgoing>Flow_1m87uz7</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="Gateway_1qtpk5b"><bpmn:incoming>Flow_0mv6045</bpmn:incoming><bpmn:outgoing>Flow_08zshvr</bpmn:outgoing><bpmn:outgoing>Flow_1xf0tjd</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_0b17ezj"><bpmn:incoming>Flow_1xf0tjd</bpmn:incoming><bpmn:incoming>Flow_1dyw64l</bpmn:incoming><bpmn:outgoing>Flow_0ermmma</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="Event_1mt93u4" name="сформирована первичная кассовая документация по итогам работы за день"><bpmn:incoming>Flow_041sr4x</bpmn:incoming></bpmn:endEvent><bpmn:subProcess id="Activity_0lmv2fe" name="П 6.&#10;Административные операции на кассе"><bpmn:incoming>Flow_0urz1lp</bpmn:incoming><bpmn:outgoing>Flow_19ug167</bpmn:outgoing></bpmn:subProcess><bpmn:subProcess id="Activity_0i82ydz" name="П 7.&#10;Возврат товара от покупателя"><bpmn:incoming>Flow_